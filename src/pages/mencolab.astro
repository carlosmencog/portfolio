---
import '../styles/mencolab.css';

const services = [
  {
    title: 'Branding & Design',
    text: 'We build brands people remember. From naming and logo design to visual systems, social templates and digital assets, we shape a professional identity ready to grow.',
    tags: ['Naming', 'Logo', 'Visual identity', 'Brand kit'],
  },
  {
    title: 'Digital Presence',
    text: 'Your website should be your best salesperson. We create fast, intuitive experiences focused on credibility, clarity and conversion.',
    tags: ['Websites', 'Landing pages', 'SEO foundations', 'Conversion'],
  },
  {
    title: 'Automation',
    text: 'We remove repetitive work with smart forms, booking flows, quotes, WhatsApp, email follow-ups, reports and operational workflows.',
    tags: ['Workflows', 'WhatsApp', 'Reports', 'CRM flows'],
  },
  {
    title: 'Custom Software',
    text: 'When the tool you need does not exist, we build it around your business: admin systems, dashboards, billing, inventories, directories and client portals.',
    tags: ['Laravel', 'Dashboards', 'Portals', 'Internal tools'],
  },
  {
    title: 'Artificial Intelligence',
    text: 'We turn AI into a practical advantage with assistants, customer support tools, document analysis, smart search, classification and content systems.',
    tags: ['AI assistants', 'Documents', 'Search', 'Content'],
  },
  {
    title: 'Continuous Optimization',
    text: 'Your project keeps evolving after launch with new features, performance improvements, security, maintenance and support.',
    tags: ['Support', 'Security', 'New features', 'Growth'],
  },
];

const process = [
  ['01', 'Discover the problem'],
  ['02', 'Design the strategy'],
  ['03', 'Build the solution'],
  ['04', 'Evolve with you'],
];

const useCases = ['Restaurants', 'Clinics', 'Service companies', 'Commerce', 'Personal brands', 'Startups'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MencoLab | Digital solutions for growing businesses</title>
    <meta
      name="description"
      content="MencoLab designs brands, websites, automation and custom software for businesses that want to grow with technology."
    />
    <link rel="icon" type="image/png" href="/imgs/favicon.png" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-43KJ0388SJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-43KJ0388SJ');
    </script>
  </head>
  <body class="mencolab-page">
    <div class="ml-page">
      <header class="ml-nav">
        <div class="ml-container ml-nav-inner">
          <a class="ml-brand" href="/mencolab/" aria-label="MencoLab home">Menco<span>Lab</span></a>
          <nav class="ml-nav-links" aria-label="MencoLab navigation">
            <a href="#services">Services</a>
            <a href="#process">Process</a>
            <a href="#use-cases">Use cases</a>
            <a class="ml-button" href="mailto:carlosmenco@gmail.com?subject=MencoLab%20project">Let's talk</a>
          </nav>
        </div>
      </header>

      <main>
        <section class="ml-hero" id="top">
          <div class="ml-container ml-hero-grid">
            <div>
              <div class="ml-kicker">Digital studio for practical growth</div>
              <h1 class="ml-hero-title">Tech that grows your <span>business.</span></h1>
            </div>
            <div class="ml-hero-copy">
              <p>
                We design brands, craft digital experiences and build tools that help companies sell more,
                automate operations and move with confidence.
              </p>
              <div class="ml-hero-actions">
                <a class="ml-button" href="mailto:carlosmenco@gmail.com?subject=MencoLab%20project">Talk about your project</a>
                <a class="ml-link-button" href="#services">Explore solutions</a>
              </div>
            </div>
          </div>
        </section>

        <section class="ml-section">
          <div class="ml-container">
            <div class="ml-section-head">
              <div class="ml-section-number">01</div>
              <div>
                <h2 class="ml-section-title">You do not need to understand technology.</h2>
              </div>
            </div>
            <p class="ml-lede">
              You need results. We turn ideas, processes and business problems into digital solutions that
              are easy to use and built to create value from day one.
            </p>
            <div class="ml-marquee" aria-hidden="true">
              <span>Branding</span><span>Websites</span><span>Automation</span><span>Software</span><span>AI</span>
              <span>Branding</span><span>Websites</span><span>Automation</span><span>Software</span><span>AI</span>
            </div>
          </div>
        </section>

        <section class="ml-section ml-section-dark" id="services">
          <div class="ml-container">
            <div class="ml-section-head">
              <div class="ml-section-number">02</div>
              <div>
                <h2 class="ml-section-title">Solutions for every stage of growth.</h2>
              </div>
            </div>
            <div class="ml-services">
              {services.map((service, index) => (
                <article class="ml-service">
                  <div class="ml-service-number">{String(index + 1).padStart(2, '0')}</div>
                  <h3>{service.title}</h3>
                  <div>
                    <p>{service.text}</p>
                    <div class="ml-tags">
                      {service.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="ml-section" id="process">
          <div class="ml-container">
            <div class="ml-section-head">
              <div class="ml-section-number">03</div>
              <div>
                <h2 class="ml-section-title">A clear process from idea to launch.</h2>
              </div>
            </div>
            <div class="ml-process">
              {process.map(([number, title]) => (
                <article class="ml-process-step">
                  <span>{number}</span>
                  <h3>{title}</h3>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="ml-section" id="use-cases">
          <div class="ml-container">
            <div class="ml-section-head">
              <div class="ml-section-number">04</div>
              <div>
                <h2 class="ml-section-title">Built for real business scenarios.</h2>
              </div>
            </div>
            <div class="ml-use-cases">
              {useCases.map((item) => <div class="ml-use-case">{item}</div>)}
            </div>
          </div>
        </section>

        <section class="ml-section ml-section-dark">
          <div class="ml-container ml-cta">
            <h2>Tell us what you want to build.</h2>
            <div>
              <p>
                You do not need to know which technology to use. Tell us what you want to achieve and we
                will design the smartest path to make it real.
              </p>
              <a class="ml-button" href="mailto:carlosmenco@gmail.com?subject=MencoLab%20project">Start a conversation</a>
            </div>
          </div>
        </section>
      </main>

      <footer class="ml-footer">
        <div class="ml-container ml-footer-inner">
          <div>
            <strong>MencoLab</strong>
            <p>Brands, software and automation for companies that want to grow with technology.</p>
          </div>
          <a href="mailto:carlosmenco@gmail.com">carlosmenco@gmail.com</a>
        </div>
      </footer>
    </div>
  </body>
</html>
