---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Carlos Menco Guardo" mainClass="main-content" activePage="index" pageScripts={["/js/landing-animation.js"]}>
<div class="landing-section">
      <section class="s1">
        <div class="landing-avatar" id="anim-avatar">
          <img src="/imgs/avatar.png" alt="Menco&#39;s avatar" />
        </div>
        <h5 class="landing-title" id="anim-title">Hi, I&#39;m Menco.</h5>
        <div class="landing-text">
          <p class="anim-sentence">I'm a developer focused on creating efficient digital solutions, with experience in CMS platforms like WordPress and Shopify, and drawn to build clean and functional interfaces using modern frameworks like Bootstrap or TailWind.</p>
          <p class="anim-sentence">I'm interested in optimizing processes, simplifying workflows, and building tools that truly deliver value.</p>
          <p class="anim-sentence">That's why I'm constantly exploring new forms of automation, especially leveraging the potential of artificial intelligence to improve productivity, reduce repetitive tasks, and open up new possibilities in web development.</p>
        </div>
      </section>
      <section class="s1">
        <div class="landing-social" id="anim-social">
          <a href="mailto:carlosmenco@gmail.com" target="_blank" rel="noreferrer noopener"
            class="external-link">Email <span class="external-link-icon"><svg width="16" height="16"
