                <g clip-path="url(#clip0_44_2985)">
                  <path
                    d="M4.22876 4.22924V5.5586L9.49435 5.56332L3.75736 11.3003L4.70017 12.2431L10.4372 6.50613L10.4324 11.7717H11.7712V4.22924H4.22876Z"
