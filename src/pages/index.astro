                    fill="currentColor"></path>
                </g>
                <defs>
                  <clipPath id="clip0_44_2985">
                    <rect width="16" height="16" fill="white"></rect>
                  </clipPath>
                </defs>
              </svg>
            </span></a>
          <a href="tel:573153048629" target="_blank" rel="noreferrer noopener" class="external-link">Phone <span class="external-link-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g clip-path="url(#clip0_44_2985)">
                  <path
                    d="M4.22876 4.22924V5.5586L9.49435 5.56332L3.75736 11.3003L4.70017 12.2431L10.4372 6.50613L10.4324 11.7717H11.7712V4.22924H4.22876Z"
